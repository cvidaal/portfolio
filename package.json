{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "npm run lhci:mobile && npm run lhci:desktop",
    "avatar:bake": "node scripts/avatar/bake.mjs",
    "lhci:mobile": "lhci autorun --upload.outputDir=.lighthouseci/mobile",
    "lhci:desktop": "lhci autorun --collect.settings.preset=desktop --upload.outputDir=.lighthouseci/desktop",
    "check": "astro check && tsc --noEmit",
    "cv": "node scripts/make-cv.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "sharp": "^0.35.5",
    "simple-icons": "13.21.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
