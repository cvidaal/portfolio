---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/global.css';
import { t } from '../i18n';
import { THEMES } from '../lib/theme';
import { SAVE_KEY } from '../lib/save-key';
// Mismas URL con hash que emiten los @font-face de fontsource: precargarlas evita el salto de layout al cambiar de fuente.
import fontDisplay from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import fontMono400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import fontMono600 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-600-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  /** Páginas que no deben indexarse (404): robots noindex y sin canonical ni og:url. */
  noindex?: boolean;
}

const SITE = 'https://www.cvidal.dev';
const { title, description, path, ogImage = '/og.png', noindex = false } = Astro.props;
const canonical = `${SITE}${path}`;
const image = ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontMono400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontMono600} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#101012" />
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script is:inline define:vars={{ THEMES, SAVE_KEY }}>
      // Tema guardado antes de la primera pintura (evita el parpadeo rojo -> azul/verde). Tolera storage bloqueado.
      try {
        var s = JSON.parse(localStorage.getItem(SAVE_KEY) || 'null');
        var th = s && typeof s.theme === 'string' && Object.prototype.hasOwnProperty.call(THEMES, s.theme) ? THEMES[s.theme] : null;
        if (th && s.theme !== 'rojo') {
          var st = document.documentElement.style;
          st.setProperty('--acc', th.acc); st.setProperty('--accent', th.acc);
          st.setProperty('--accent-hi', th.hi); st.setProperty('--avatar-filter', th.filter || 'none');
        }
      } catch (e) {}
    </script>
    <script is:inline>
      // Apariciones al hacer scroll: solo se ocultan los .reveal si hay JS, IntersectionObserver y movimiento permitido.
      // Si reveal.ts no llega a ejecutarse en 3 s, se vuelve a mostrar todo.
      try {
        var d = document.documentElement;
        if ('IntersectionObserver' in window && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          d.classList.add('js-reveal');
          setTimeout(function () { if (!window.__reveal) d.classList.remove('js-reveal'); }, 3000);
        }
      } catch (e) {}
    </script>
  </head>
  <body id="top">
    <a class="skip" href="#main">{t("nav.saltar")}</a>
    <slot />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
