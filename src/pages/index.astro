---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
import { isPlaceholder, showPlaceholders } from '../lib/placeholder';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Poster from '../components/Poster.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Stack from '../components/Stack.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

// Sin texto real de Carlos, "Sobre mí" no se publica en producción (solo se muestra en dev).
const mostrarSobreMi = showPlaceholders || !isPlaceholder(t('sobre.texto'));
---
<Base title={t('meta.titulo')} description={t('meta.descripcion')} path="/">
  <Nav />
  <main id="main">
    <Hero />

    <section id="experiencia" aria-label={t('seccion.experiencia')}>
      <Poster num="01" titulo={t('seccion.experiencia')} />
      <Experience />
    </section>

    <section id="proyectos" aria-label={t('seccion.proyectos')}>
      <Poster num="02" titulo={t('seccion.proyectos')} meta={t('seccion.proyectosResumen')} />
      <Projects />
      <Stack />
    </section>

    {mostrarSobreMi && (
      <section id="sobre-mi" aria-label={t('seccion.sobre')}>
        <Poster num="03" titulo={t('seccion.sobre')} />
        <About />
      </section>
    )}

    <section id="contacto" aria-label={t('seccion.contacto')}>
      <Poster num="04" titulo={t('seccion.contacto')} />
      <Contact />
    </section>
  </main>
  <Footer />
</Base>
<style>
  section[id] { scroll-margin-top: 52px; }
</style>
