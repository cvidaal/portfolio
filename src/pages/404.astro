---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
---
<Base
  title={`${t('error404.titulo')} · Carlos Vidal`}
  description={t('error404.descripcion')}
  path="/404"
  noindex
>
  <main class="nf">
    <p class="code">404</p>
    <h1>{t('error404.texto')}</h1>
    <a href="/">{t('error404.volver')}</a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    padding: 2rem 1.25rem;
    max-width: 40rem;
    margin: 0 auto;
  }
  .code { color: var(--accent); margin: 0; }
  h1 { font-size: clamp(2rem, 8vw, 3.5rem); }
  a { color: var(--paper); text-decoration-color: var(--accent); text-underline-offset: 4px; width: fit-content; }
</style>
