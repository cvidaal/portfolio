---
import { t } from '../i18n';
---
<footer class="foot">
  <div class="wrap foot-in mono">
    <span>{t('footer.copy')}</span>
    <a href="#top">{t('footer.subir')}</a>
  </div>
</footer>
<style>
  .foot { border-top: 1px solid var(--line); }
  .foot-in { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-block: 22px; font-size: 12px; color: var(--muted); }
  a { color: var(--muted); }
  a:hover { color: var(--paper); }
</style>
