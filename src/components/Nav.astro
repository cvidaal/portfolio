---
import { t } from '../i18n';
---
<header class="nav">
  <nav class="wrap nav-in" aria-label={t('nav.aria')}>
    <a class="nav-home" href="/">{t('nav.inicio')}</a>
    <ul class="mono">
      <li><a href="#experiencia">{t('nav.experiencia')}</a></li>
      <li><a href="#proyectos">{t('nav.proyectos')}</a></li>
      <li><a href="#contacto">{t('nav.contacto')}</a></li>
      <li><a class="nav-cv" href={t('cv.href')}>{t('nav.cv')}</a></li>
    </ul>
  </nav>
</header>
<style>
  .nav { position: sticky; top: 0; z-index: 20; background: rgba(16, 16, 18, 0.92); border-bottom: 1px solid var(--line); backdrop-filter: blur(6px); }
  .nav-in { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0 12px; min-height: 52px; }
  .nav-home { font-weight: 800; letter-spacing: -0.03em; text-decoration: none; font-size: 18px; }
  ul { display: flex; flex-wrap: wrap; gap: 0 clamp(10px, 3vw, 22px); list-style: none; margin: 0; padding: 0; font-size: 12px; }
  ul a { text-decoration: none; color: var(--muted); padding: 10px 2px; display: inline-block; }
  ul a:hover { color: var(--paper); }
  ul a.nav-cv { color: var(--bg); background: var(--accent-hi); padding: 4px 9px; font-weight: 600; }
  @media (max-width: 420px) { .nav-home { font-size: 15px; } }
</style>
