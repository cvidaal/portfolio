---
import { t } from '../../i18n';
interface Props { secciones: { id: string; label: string }[] }
const { secciones } = Astro.props;
---
<nav class="toc mono" aria-label={t('caso.indice')}>
  <ol>
    {secciones.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
  </ol>
</nav>
<style>
  .toc ol { list-style: none; margin: 0; padding: 0; counter-reset: toc; display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 12px; }
  .toc li { counter-increment: toc; }
  .toc a { color: var(--muted); text-decoration: none; display: inline-block; padding: 6px 0; }
  .toc a::before { content: counter(toc, decimal-leading-zero) ' '; }
  .toc a:hover { color: var(--paper); }
  .toc a[aria-current] { color: var(--paper); }
  .toc a[aria-current]::before { content: '■ ' counter(toc, decimal-leading-zero) ' '; color: var(--accent-hi); }
  @media (min-width: 900px) {
    .toc { position: sticky; top: 68px; align-self: start; }
    .toc ol { flex-direction: column; flex-wrap: nowrap; gap: 3px; font-size: 12.5px; }
  }
</style>
