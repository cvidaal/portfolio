---
interface Props { v1: string; v1Detalle: string; v2: string; v2Detalle: string }
const { v1, v1Detalle, v2, v2Detalle } = Astro.props;
---
<div class="evo">
  <div class="v mono"><b>{v1}</b>{v1Detalle}</div>
  <div class="arrow" aria-hidden="true">→</div>
  <div class="v now mono"><b>{v2}</b>{v2Detalle}</div>
</div>
<style>
  .evo { display: grid; grid-template-columns: 1fr; align-items: center; margin-top: 16px; gap: 8px; }
  .v { border: 1px solid var(--line); padding: 14px; font-size: 12px; color: var(--muted); }
  .v b { display: block; color: var(--paper); font: 800 22px/1.1 var(--font-display); margin-bottom: 6px; }
  .v.now { border-color: var(--accent); }
  .arrow { text-align: center; color: var(--accent-hi); font-size: 22px; transform: rotate(90deg); }
  @media (min-width: 700px) { .evo { grid-template-columns: 1fr 40px 1fr; } .arrow { transform: none; } }
</style>
