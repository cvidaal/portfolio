---
// Diagrama de Acelerik Booking en estilo risografía. Solo muestra piezas que existen en backend/cmd/api/main.go.
---
<figure class="arch">
  <svg viewBox="0 0 680 200" role="img" aria-labelledby="arch-t arch-d">
    <title id="arch-t">Arquitectura de Acelerik Booking</title>
    <desc id="arch-d">La web habla con una API en Go con los módulos booking y payment. La API usa PostgreSQL y crea sesiones de Stripe Checkout. Stripe avisa a la API con un webhook firmado.</desc>
    <defs>
      <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="7" stroke="#101012" stroke-opacity="0.28" stroke-width="2" />
      </pattern>
      <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="#E4251B" />
      </marker>
    </defs>
    <g fill="#17171A" stroke="#F1EDE6" stroke-width="1.5">
      <rect x="10" y="70" width="120" height="50" />
      <rect x="230" y="40" width="190" height="110" />
      <rect x="520" y="20" width="150" height="50" />
      <rect x="520" y="120" width="150" height="50" />
    </g>
    <rect x="236" y="46" width="178" height="22" fill="#E4251B" />
    <rect x="236" y="46" width="178" height="22" fill="url(#hatch)" />
    <g fill="#F1EDE6" font-family="JetBrains Mono, monospace" font-size="12">
      <text x="30" y="100">Web</text>
      <text x="246" y="62" fill="#101012" font-weight="600">API Go · Huma</text>
      <text x="246" y="92">booking · payment</text>
      <text x="246" y="112">estados · plazas</text>
      <text x="246" y="132">OpenAPI /docs</text>
      <text x="540" y="50">PostgreSQL</text>
      <text x="540" y="150">Stripe Checkout</text>
    </g>
    <g stroke="#E4251B" stroke-width="2" fill="none" marker-end="url(#arrow)">
      <path d="M130 95 L228 95" />
      <path d="M420 70 L518 45" />
      <path d="M420 115 L518 140" />
      <path d="M560 172 C 500 195 440 185 422 150" stroke-dasharray="5 4" />
    </g>
    <text x="440" y="198" fill="#9A968F" font-family="JetBrains Mono, monospace" font-size="11">webhook firmado</text>
  </svg>
</figure>
<style>
  .arch { margin: 6px 0 0; max-width: 680px; }
  svg { width: 100%; height: auto; display: block; }
</style>
