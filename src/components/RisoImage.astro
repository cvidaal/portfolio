---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  fit?: 'cover' | 'contain';
  position?: string;
  /** Logotipo pequeño en una esquina en vez de imagen a sangre. */
  logo?: boolean;
  ratio?: string;
  widths?: number[];
  sizes?: string;
}
const { src, alt, fit = 'cover', position = 'left top', logo = false, ratio, widths, sizes } = Astro.props;
---
<div class:list={['riso', { logo }]} style={ratio ? `--ratio:${ratio}` : undefined}>
  <Image src={src} alt={alt} widths={widths ?? (logo ? [120, 240] : [480, 800, 1200])} sizes={sizes ?? (logo ? '120px' : '(min-width: 900px) 600px, 100vw')}
    style={`object-fit:${fit};object-position:${position}`} />
  <slot />
</div>
<style>
  /* Risografía: en reposo la imagen es un duotono rojo sobre papel; al pasar por la tarjeta se revela el color. */
  .riso { position: relative; overflow: hidden; background: var(--paper); aspect-ratio: var(--ratio, 16 / 10); min-height: 0; isolation: isolate; }
  .riso :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; filter: grayscale(1) contrast(1.2); mix-blend-mode: multiply; transition: transform 0.5s; }
  .riso::after { content: ''; position: absolute; inset: 0; background: var(--accent); mix-blend-mode: lighten; transition: opacity 0.35s; pointer-events: none; }
  .riso::before { content: ''; position: absolute; inset: 0; z-index: 1; background: repeating-linear-gradient(45deg, rgba(228, 37, 27, 0) 0 6px, rgba(228, 37, 27, 0.18) 6px 8px); pointer-events: none; transition: opacity 0.35s; }
  .riso.logo :global(img) { inset: auto; right: 16px; top: 14px; width: min(40%, 120px); height: auto; z-index: 3; }
  .riso:hover::after, .riso:hover::before,
  :global(.card:hover) .riso::after, :global(.card:hover) .riso::before,
  :global(.card:focus-within) .riso::after, :global(.card:focus-within) .riso::before { opacity: 0; }
  .riso:hover :global(img), :global(.card:hover) .riso :global(img), :global(.card:focus-within) .riso :global(img) { filter: none; mix-blend-mode: normal; transform: scale(1.03) translate(3px, -2px); }
  .riso.logo:hover :global(img), :global(.card:hover) .riso.logo :global(img), :global(.card:focus-within) .riso.logo :global(img) { transform: none; }
  @media (prefers-reduced-motion: reduce) { .riso :global(img) { transform: none !important; } }
</style>
